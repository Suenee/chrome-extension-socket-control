{
  "manifest_version": 3,
  "name": "Client Socket Control",
  "version": "0.16",
  "description": "VPP/SUB control of Chrome and Brave windows and tabs.",
  "permissions": [
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "ws://*/*",
    "wss://*/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Client Socket Control"
  },
  "options_page": "options/options.html"
}
