{
  "manifest_version": 3,
  "name": "Chrome Client Socket Control",
  "version": "0.12",
  "description": "VPP/SUB control of Chrome and Brave windows and tabs.",
  "permissions": ["tabs", "storage"],
  "host_permissions": ["ws://*/*", "wss://*/*"],
  "background": {"service_worker": "src/background.js", "type": "module"},
  "action": {"default_title": "Socket Control", "default_popup": "popup/popup.html"}
}
