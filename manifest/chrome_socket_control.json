{
  "manifestVersion": 1,
  "id": "chrome_socket_control",
  "name": "Client Socket Control",
  "version": "1.01",
  "description": "Chrome/Brave window and tab control profile for Socket Universe Module.",
  "vppVersion": 1,
  "namespace": "chrome",
  "sourceApp": "SocketUniverseModule",
  "peerLabel": "Client Socket Control",
  "configFields": [],
  "variables": [
    {
      "id": "connected",
      "name": "SUB connected (1/0)",
      "role": "serverConnected"
    },
    {
      "id": "chrome_connected",
      "name": "Chrome Socket Control connected (1/0)",
      "role": "peerConnected"
    },
    {
      "id": "connection_state",
      "name": "Connection state",
      "role": "connectionState"
    },
    {
      "id": "diagnostic_level",
      "name": "Diagnostic level (green/yellow/red/gray)",
      "role": "diagnosticLevel"
    },
    {
      "id": "diagnostic_status",
      "name": "Diagnostic overall status",
      "role": "diagnosticStatus"
    },
    {
      "id": "diagnostic_sub",
      "name": "Diagnostic SUB status",
      "role": "diagnosticServer"
    },
    {
      "id": "diagnostic_chrome",
      "name": "Diagnostic Chrome status",
      "role": "diagnosticPeer"
    },
    {
      "id": "diagnostic_reason",
      "name": "Diagnostic reason",
      "role": "diagnosticReason"
    },
    {
      "id": "window_count",
      "name": "Browser window count"
    },
    {
      "id": "tab_count",
      "name": "Browser tab count"
    },
    {
      "id": "browser_state",
      "name": "Browser state JSON"
    },
    {
      "id": "windows",
      "name": "Browser windows JSON"
    },
    {
      "id": "tabs",
      "name": "Browser tabs JSON"
    }
  ],
  "dynamicVariables": [],
  "settings": {},
  "memory": {},
  "dynamicCollections": {
    "windows": {
      "event": "browserStateChanged",
      "path": "windows",
      "item": {
        "value": "persistentWindowId",
        "label": "label"
      }
    },
    "tabs": {
      "event": "browserStateChanged",
      "path": "tabs",
      "item": {
        "value": "persistentTabId",
        "label": "label"
      }
    }
  },
  "events": {
    "browserStateChanged": {
      "operation": "mapArgsToVariables",
      "expectsResponse": false,
      "args": {
        "windows": {
          "type": "array"
        },
        "tabs": {
          "type": "array"
        },
        "windowCount": {
          "type": "integer"
        },
        "tabCount": {
          "type": "integer"
        },
        "browserState": {
          "type": "array"
        },
        "browserStateJson": {
          "type": "string"
        },
        "windowsJson": {
          "type": "string"
        },
        "tabsJson": {
          "type": "string"
        }
      },
      "map": {
        "windowCount": "window_count",
        "tabCount": "tab_count",
        "browserStateJson": "browser_state",
        "windowsJson": "windows",
        "tabsJson": "tabs"
      }
    }
  },
  "replays": {},
  "actions": {
    "tab_create": {
      "name": "Tab: Create",
      "operation": "call",
      "method": "createTab",
      "expectsResponse": true,
      "queue": {
        "policy": "fifo"
      },
      "options": [
        {
          "type": "dropdown",
          "id": "windowId",
          "label": "Window",
          "default": "active",
          "arg": "persistentWindowId",
          "parse": "string",
          "choices": [
            {
              "id": "active",
              "label": "Active window"
            }
          ],
          "choicesFrom": "windows",
          "value": "persistentWindowId",
          "labelFrom": "label"
        },
        {
          "type": "textinput",
          "id": "url",
          "label": "URL",
          "default": "",
          "useVariables": true,
          "multiline": false,
          "arg": "url",
          "parse": "string"
        }
      ]
    },
    "tab_close": {
      "name": "Tab: Close",
      "operation": "call",
      "method": "closeTab",
      "expectsResponse": true,
      "queue": {
        "policy": "fifo"
      },
      "options": [
        {
          "type": "dropdown",
          "id": "tabId",
          "label": "Tab",
          "default": "",
          "arg": "persistentTabId",
          "parse": "string",
          "choicesFrom": "tabs",
          "value": "persistentTabId",
          "labelFrom": "label"
        }
      ]
    },
    "tab_activate": {
      "name": "Tab: Activate",
      "operation": "call",
      "method": "activateTab",
      "expectsResponse": true,
      "queue": {
        "policy": "replace",
        "key": "tab.activate"
      },
      "options": [
        {
          "type": "dropdown",
          "id": "tabId",
          "label": "Tab",
          "default": "",
          "arg": "persistentTabId",
          "parse": "string",
          "choicesFrom": "tabs",
          "value": "persistentTabId",
          "labelFrom": "label"
        }
      ]
    },
    "tab_move": {
      "name": "Tab: Move to Window",
      "operation": "call",
      "method": "moveTab",
      "expectsResponse": true,
      "queue": {
        "policy": "fifo"
      },
      "options": [
        {
          "type": "dropdown",
          "id": "tabId",
          "label": "Tab",
          "default": "",
          "arg": "persistentTabId",
          "parse": "string",
          "choicesFrom": "tabs",
          "value": "persistentTabId",
          "labelFrom": "label"
        },
        {
          "type": "dropdown",
          "id": "windowId",
          "label": "Target Window",
          "default": "",
          "arg": "persistentWindowId",
          "parse": "string",
          "choicesFrom": "windows",
          "value": "persistentWindowId",
          "labelFrom": "label"
        },
        {
          "type": "number",
          "id": "index",
          "label": "Position (-1 = end)",
          "default": -1,
          "arg": "index",
          "parse": "integer"
        }
      ]
    },
    "window_create": {
      "name": "Window: Create",
      "operation": "call",
      "method": "createWindow",
      "expectsResponse": true,
      "queue": {
        "policy": "fifo"
      },
      "options": [
        {
          "type": "dropdown",
          "id": "state",
          "label": "Window state",
          "default": "default",
          "arg": "state",
          "parse": "string",
          "choices": [
            {
              "id": "default",
              "label": "Default"
            },
            {
              "id": "maximized",
              "label": "Maximized"
            }
          ]
        }
      ]
    },
    "window_focus": {
      "name": "Window: Focus",
      "operation": "call",
      "method": "focusWindow",
      "expectsResponse": true,
      "queue": {
        "policy": "replace",
        "key": "window.focus"
      },
      "options": [
        {
          "type": "dropdown",
          "id": "windowId",
          "label": "Window",
          "default": "",
          "arg": "persistentWindowId",
          "parse": "string",
          "choicesFrom": "windows",
          "value": "persistentWindowId",
          "labelFrom": "label"
        }
      ]
    },
    "window_close": {
      "name": "Window: Close",
      "operation": "call",
      "method": "closeWindow",
      "expectsResponse": true,
      "queue": {
        "policy": "fifo"
      },
      "options": [
        {
          "type": "dropdown",
          "id": "windowId",
          "label": "Window",
          "default": "",
          "arg": "persistentWindowId",
          "parse": "string",
          "choicesFrom": "windows",
          "value": "persistentWindowId",
          "labelFrom": "label"
        }
      ]
    },
    "tab_focus": {
      "name": "Tab: Focus",
      "operation": "call",
      "method": "focusTab",
      "expectsResponse": true,
      "queue": {
        "policy": "replace",
        "key": "tab.focus"
      },
      "options": [
        {
          "type": "dropdown",
          "id": "tabId",
          "label": "Tab",
          "default": "",
          "arg": "persistentTabId",
          "parse": "string",
          "choicesFrom": "tabs",
          "value": "persistentTabId",
          "labelFrom": "label"
        }
      ]
    }
  },
  "presets": []
}
